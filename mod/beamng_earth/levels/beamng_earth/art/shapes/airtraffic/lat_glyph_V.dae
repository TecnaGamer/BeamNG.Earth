<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
<asset><contributor><authoring_tool>BeamNG.Earth tools/build_airtraffic_shapes.py (models: devo343, Live Air Traffic)</authoring_tool></contributor><unit meter="1" name="meter"/><up_axis>Z_UP</up_axis></asset>
<library_effects>
<effect id="lat_text-fx"><profile_COMMON><technique sid="common"><lambert><diffuse><color>0.07 0.09 0.17 1</color></diffuse></lambert></technique></profile_COMMON></effect>
</library_effects>
<library_materials>
<material id="lat_text-mat" name="lat_text"><instance_effect url="#lat_text-fx"/></material>
</library_materials>
<library_geometries>
<geometry id="lat_glyph_V8-g"><mesh>
<source id="lat_glyph_V8-g-p"><float_array id="lat_glyph_V8-g-p-a" count="21">0 0.266 1 0 0.007 1 0 0.377 0 0 0.684 0 0 1.055 1 0 0.796 1 0 0.531 0.262</float_array><technique_common><accessor source="#lat_glyph_V8-g-p-a" count="7" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
<vertices id="lat_glyph_V8-g-v"><input semantic="POSITION" source="#lat_glyph_V8-g-p"/></vertices>
<triangles count="5" material="lat_text-mat"><input semantic="VERTEX" source="#lat_glyph_V8-g-v" offset="0"/><p>0 1 2 2 3 4 4 5 6 6 0 2 6 2 4</p></triangles>
</mesh></geometry>
</library_geometries>
<library_visual_scenes><visual_scene id="scene" name="scene">
<node id="base00" name="base00"><node id="start01" name="start01">
<node id="lat_glyph_V8" name="lat_glyph_V8"><instance_geometry url="#lat_glyph_V8-g"><bind_material><technique_common><instance_material symbol="lat_text-mat" target="#lat_text-mat"/></technique_common></bind_material></instance_geometry></node>
</node><node id="collision-1" name="collision-1"/></node>
</visual_scene></library_visual_scenes>
