# Bucket credentials for the on-demand aerial builder (hosting/systemd/bnge-aerial-builder.service).
# Copy to ~/bnge-builder/r2.env on the builder machine, fill in your own values there, and keep it private:
#   umask 077; cp r2.env.example ~/bnge-builder/r2.env; chmod 600 ~/bnge-builder/r2.env
# Never commit the filled-in file, never paste its values into a chat, issue or log.
# The token needs Object Read & Write on this one bucket only (docs/HOSTING.md, "Bucket and domain").

# Your Cloudflare account ID: the endpoint becomes https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-account-id
# The R2 API token's S3 credentials
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: the bucket behind your tile domain (default: bnge-tiles)
R2_BUCKET=your-bucket-name
